# Copy to .env and fill in values before running docker-compose

# Database (docker-compose creates this automatically)
POSTGRES_PASSWORD=change_me_in_production

# JWT secrets — generate with: openssl rand -base64 64
JWT_SECRET=replace_with_random_secret
JWT_REFRESH_SECRET=replace_with_different_random_secret

# App URLs
CLIENT_URL=http://localhost

# File uploads — leave blank to skip in dev
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Email — leave blank to skip in dev
RESEND_API_KEY=
