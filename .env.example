# Copy to .env and fill in all values before deploying

# ── Domain (production only) ─────────────────────────────────────────────────
# Your domain pointing to the VPS — Caddy gets SSL automatically
DOMAIN=yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password
# Local dev can set a full connection string directly instead:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clientportal365

# ── JWT secrets ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_random_64_char_secret
JWT_REFRESH_SECRET=replace_with_different_random_64_char_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Optional integrations ─────────────────────────────────────────────────────
# Leave blank in dev — app runs without them
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=clientportal365
RESEND_API_KEY=
FROM_EMAIL=noreply@businessvalue365.com
FROM_NAME=ClientPortal365

# ── App ────────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
SERVER_PORT=3001
NODE_ENV=development
