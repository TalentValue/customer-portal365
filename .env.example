# ── Database (TDD §10.2) ──────────────────────────────────────────────
DATABASE_URL=                 # Postgres connection string
DIRECT_URL=                   # Direct (non-pooled) connection for migrations

# ── Auth: Clerk ───────────────────────────────────────────────────────
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── Billing: Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email: Resend ─────────────────────────────────────────────────────
RESEND_API_KEY=

# ── File storage: S3-compatible ───────────────────────────────────────
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Rate limiting / cache (optional) ──────────────────────────────────
REDIS_URL=

# ── App ───────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000  # Base URL for links/emails
NODE_ENV=development
